    {
      "parameters": {
        "jsCode": "// 1. Pega o texto bruto que veio no campo \"output\" do nó anterior\nlet rawText = $input.first().json.output || \"\";\n\n// 2. Remove possíveis blocos de formatação markdown (```json ... ```) caso a IA tenha inserido\nconst cleanText = rawText.replace(/^```(json)?|```$/gm, '').trim();\n\ntry {\n  // 3. Transforma a string de texto em um Array JavaScript real\n  const parsedArray = JSON.parse(cleanText);\n\n  // 4. Corrige as chaves e formata a saída\n  // (A IA mudou \"topico_principal\" para \"topico principal\" e \"passo_id\" para \"passo\")\n  const finalItems = parsedArray.map(item => {\n    return {\n      topico_principal: item[\"topico principal\"] || item.topico_principal || \"\",\n      passo_id: item.passo || item.passo_id || \"\",\n      descricao_subtopico: item.descricao_subtopico || \"\"\n    };\n  });\n\n  // 5. Retorna o array. \n  // O n8n automaticamente transforma cada objeto do array em uma \"linha/item\" separada!\n  return finalItems;\n\n} catch (error) {\n  // Se a IA cuspir algo muito quebrado, o nó avisa exatamente o erro\n  throw new Error(\"Falha ao processar o JSON gerado pela IA. Texto recebido: \" + rawText);\n}"
      },
