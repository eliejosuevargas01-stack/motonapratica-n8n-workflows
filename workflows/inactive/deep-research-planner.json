        "jsCode": "// Pega os dados que chegaram no Webhook\nconst item = $input.first().json;\n\nconst errors = [];\nconst EXPECTED_SECRET = \"bowT7Vwgclr4bUcJd80xZXgyVml2HzjQdCRYNKX8rjiq3TorPWyw3EiHezl\";\n\n// 1. Validate query.id (Must exist, not empty, and MUST be an integer)\nconst idRaw = item.query?.id;\nconst idNum = Number(idRaw);\n\nif (idRaw === undefined || idRaw === null || String(idRaw).trim() === '') {\n  errors.push(\"Missing or empty required parameter: 'query.id'.\");\n} else if (isNaN(idNum) || !Number.isInteger(idNum)) {\n  errors.push(\"Invalid parameter: 'query.id' must be a valid integer number (e.g. 123456).\");\n}\n\n// 2. Validate body.tema\nconst tema = item.body?.tema;\nif (tema === undefined || tema === null || String(tema).trim() === '') {\n  errors.push(\"Missing or empty required parameter: 'body.tema'.\");\n}\n\n// 3. Validate x-apify-secret\nconst secretHeader = item.headers ? (item.headers['x-apify-secret'] || item.headers['X-Apify-Secret']) : undefined;\n\nif (!secretHeader || String(secretHeader).trim() === '') {\n  errors.push(\"Missing required header: 'x-apify-secret'.\");\n} else if (secretHeader !== EXPECTED_SECRET) {\n  errors.push(\"Unauthorized: Invalid 'x-apify-secret' header provided.\");\n}\n\n// 4. Validate body.webhook_callback\nconst webhookCallback = item.body?.webhook_callback;\nif (webhookCallback === undefined || webhookCallback === null || String(webhookCallback).trim() === '') {\n  errors.push(\"Missing or empty required parameter: 'body.webhook_callback'.\");\n}\n\nconst isValid = errors.length === 0;\n\n// Return JSON error response\nreturn [{\n  json: {\n    status: isValid ? 200 : 400,\n    success: isValid,\n    is_valid: isValid,\n    error: isValid ? null : \"Input Validation Error\",\n    errors: errors,\n    message: isValid ? \"Validation successful.\" : errors.join(\" | \")\n  }\n}];"
