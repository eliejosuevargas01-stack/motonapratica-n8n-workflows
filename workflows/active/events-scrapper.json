    {
      "parameters": {
        "jsCode": "// Captura a string de entrada vinda do node anterior\nconst rawString = $input.first().json.data;\n\n// Recorta o JSON de dentro da string do Jina\nconst jsonString = rawString.split('Markdown Content:\\n')[1].trim();\nconst seasons = JSON.parse(jsonString);\n\n// Pega o objeto onde \"current\" é igual a true\nconst latestSeason = seasons.find(season => season.current === true);\n\n// O n8n EXIGE que o retorno seja um array de objetos, contendo a chave \"json\"\nreturn [\n  {\n    json: {\n      season_id: latestSeason.id,\n      season_year: latestSeason.year\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
