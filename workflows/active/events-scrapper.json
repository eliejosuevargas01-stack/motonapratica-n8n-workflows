      },
      {
        "parameters": {
          "jsCode": "// O n8n entrega os itens do node anterior na variável $input.all()\nconst rawItems = $input.all();\n\n// Mapeia os dados e filtra ao mesmo tempo\nconst mappedEvents = rawItems.map(item => {\n    const event = item.json;\n\n    // Se for um evento de teste, retornamos null (ignoramos)\n    if (event.test === true) {\n        return null;\n    }\n\n    // Estrutura o Payload Universal padronizado\n    return {\n        json: {\n            championship: \"MotoGP\",\n            season_year: event.season.year,\n            external_id: event.id,\n            event_name: event.name,\n            circuit_name: event.circuit.name,\n            country_code: event.country.iso,\n            date_start: event.date_start,\n            date_end: event.date_end,\n            // Padroniza o status para o seu frontend entender melhor\n            status: event.status === 'NOT-STARTED' ? 'UPCOMING' : event.status,\n            is_test: event.test\n        }\n    };\n}).filter(item => item !== null); // Remove todos os itens nulos (os testes)\n\nreturn mappedEvents;"
        },
